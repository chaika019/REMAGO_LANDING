{
  "name": "remago-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "check:ui": "node scripts/check-ui.mjs",
    "check:responsive": "npm run build && node scripts/check-responsive.mjs",
    "check:carousels": "node --experimental-strip-types scripts/check-carousel-motion.mjs",
    "check:faq": "node --experimental-strip-types scripts/check-faq-copy.mjs",
    "check:performance": "npm run build && node scripts/check-performance.mjs",
    "check:performance:logic": "node scripts/check-performance-profiles.mjs",
    "media:prepare": "node --env-file-if-exists=.env scripts/prepare-rtv-videos.mjs",
    "media:upload": "node --env-file-if-exists=.env scripts/upload-rtv-videos.mjs",
    "media:check": "node --env-file-if-exists=.env scripts/check-rtv-videos.mjs",
    "media:test": "node --test scripts/rtv-media.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "@types/leaflet": "^1.9.21",
    "esbuild": "0.28.2"
  }
}
