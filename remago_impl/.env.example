# Public URL only; never put S3 credentials in VITE_ variables.
# Empty uses local public/media/rtv files.
VITE_RTV_MEDIA_BASE_URL=

# Server-side/CLI upload settings (AWS CLI uses AWS_PROFILE or AWS_* credentials).
RTV_S3_BUCKET=
AWS_REGION=us-east-1
# Optional S3-compatible endpoint, e.g. https://s3.example.com (leave empty for AWS S3).
RTV_S3_ENDPOINT=
# Used only with media:upload -- --configure on a dedicated media bucket.
RTV_ALLOWED_ORIGINS=https://example.com

# Remote playback verification (public URL includes /rtv, no trailing slash).
RTV_MEDIA_PUBLIC_URL=
RTV_SITE_ORIGIN=https://example.com

# Optional executable paths and original-video directory.
# FFMPEG=/usr/bin/ffmpeg
# FFPROBE=/usr/bin/ffprobe
# RTV_INPUT_DIR=/path/to/video
